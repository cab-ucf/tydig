# Perplexiscope with its models baked in: the running container needs no network.
#   podman build -t perplexiscope .    (build args: MODEL, TORCH=cpu|cu130, DETECTOR=meld|empty)
FROM docker.io/library/python:3.12-slim
ENV HF_HOME=/opt/hf PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt /tmp/
ARG TORCH=cpu
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/$TORCH \
      $(grep ^torch= /tmp/requirements.txt) \
 && pip install --no-cache-dir -r /tmp/requirements.txt
# MELD at the commit detect.py pins; each layer makes only its own files readable by nobody
ARG DETECTOR=meld
COPY perplexiscope/detect.py /tmp/pin/
RUN [ -z "$DETECTOR" ] || { cd /tmp/pin && python -c "import detect as d, huggingface_hub as h; \
      h.snapshot_download(d.REPO, revision=d.REV)" && find /opt/hf ! -perm -o=r -exec chmod a+rX {} +; }
ARG MODEL=Qwen/Qwen3-0.6B-Base
RUN python -c "import transformers as t; t.AutoTokenizer.from_pretrained('$MODEL'); \
      t.AutoModelForCausalLM.from_pretrained('$MODEL')" && find /opt/hf ! -perm -o=r -exec chmod a+rX {} +
ENV HF_HUB_OFFLINE=1 MODEL=$MODEL DETECTOR=$DETECTOR
COPY perplexiscope /app/perplexiscope
WORKDIR /app
USER nobody
EXPOSE 8000
# a sentence calibration (calib.py) is read from /app/perplexiscope/calib/
CMD ["sh", "-c", "exec python -m perplexiscope.serve --model \"$MODEL\" --detector \"$DETECTOR\" --host 0.0.0.0"]
