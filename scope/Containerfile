# The surprise engine the hub serves its members (TYDIG_SCOPE=1): Perplexiscope
# (perplexiscope/, by Chase Brown, GPL-3.0-or-later; its engine, detector and
# server, as released), its models baked in at build, so the running container
# needs no network at all. TORCH=cu130 for an NVIDIA GPU (`just` picks it when
# podman has one to give); DETECTOR= (empty) leaves out MELD and its 4 GB.
#   podman build -t tydig-scope -f scope/Containerfile scope   (`just` does it)
FROM docker.io/library/python:3.12-slim
ARG TORCH=cpu
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/$TORCH torch==2.14.1 \
 && pip install --no-cache-dir transformers==5.19.0 tokenizers numpy pysbd fastapi "uvicorn[standard]" watchfiles
ENV HF_HOME=/opt/hf PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# MELD, the AI-text detector, at the commit detect.py pins
ARG DETECTOR=meld
COPY perplexiscope/detect.py /tmp/pin/
# (readable by nobody; only what is not yet, so no layer copies another's 4 GB)
RUN [ -z "$DETECTOR" ] || python -c "import sys; sys.path[:0] = ['/tmp/pin']; import detect as d, huggingface_hub as h; h.snapshot_download(d.REPO, revision=d.REV)" \
 && find /opt/hf ! -perm -o=r -exec chmod a+rX {} +
ARG MODEL=Qwen/Qwen3-0.6B-Base
ENV MODEL=$MODEL DETECTOR=$DETECTOR
RUN python -c "import transformers as t; t.AutoTokenizer.from_pretrained('$MODEL'); t.AutoModelForCausalLM.from_pretrained('$MODEL')" \
 && find /opt/hf ! -perm -o=r -exec chmod a+rX {} +
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
COPY perplexiscope /app/perplexiscope
WORKDIR /app
# nobody: nothing owned, nothing writable but /tmp
USER nobody
# a sentence calibration (`perplexiscope.bench calib`): mount it at /app/perplexiscope/calib/
CMD ["sh", "-c", "exec python -m perplexiscope.serve --model \"$MODEL\" --detector \"$DETECTOR\" --host 0.0.0.0 --port 8000"]
