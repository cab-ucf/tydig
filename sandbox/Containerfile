# Build sandbox for tydig recipes: one container per build, then gone.
# Network-less by default at runtime (TYDIG_BUILD_NET=1 turns it on).
#   podman build -t tydig-build sandbox/
# Add julia, R, LaTeX, etc. here as your justfiles need them.
FROM docker.io/library/python:3.12-slim

# pooch: pinned-hash data fetching, used by the project template's data recipe.
RUN pip install --no-cache-dir numpy pandas matplotlib seaborn pooch

ARG TYPST_VERSION=0.15.1
ARG JUST_VERSION=1.46.0
# make drives the project build graph (kept). typst ships .tar.xz and
# python:slim has no xz: install xz-utils for the extraction, then drop it so
# it isn't part of the build environment.
ADD https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz /tmp/typst.tar.xz
ADD https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-x86_64-unknown-linux-musl.tar.gz /tmp/just.tar.gz
RUN apt-get update \
 && apt-get install -y --no-install-recommends make xz-utils \
 && tar -xJf /tmp/typst.tar.xz -C /tmp \
 && install -m0755 /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst \
 && tar -xzf /tmp/just.tar.gz -C /usr/local/bin just \
 && chmod 0755 /usr/local/bin/just \
 && apt-get purge -y xz-utils && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/* /tmp/typst* /tmp/just* \
 && typst --version && just --version && make --version | head -1

# Typst @preview packages download on first use; the runtime has no network by
# default, so warm the cache at image build. Add the packages your documents
# import. Readable by the non-root user set below.
ENV TYPST_PACKAGE_CACHE_PATH=/opt/typst-packages
RUN mkdir -p /opt/typst-packages \
 && printf '#import "@preview/cetz:0.4.2"\n#import "@preview/tablex:0.0.9"\n' > /tmp/warm.typ \
 && typst compile /tmp/warm.typ /tmp/warm.pdf || true \
 && rm -f /tmp/warm.* \
 && chmod -R a+rX /opt/typst-packages

# non-root inside the sandbox; rootless podman maps this to your user anyway
USER 1000:1000
