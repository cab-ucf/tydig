{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tydig",
  "version": "0.1.0",
  "identifier": "pub.cxn.tydig",
  "build": { "frontendDist": "ui" },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-" }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["tydig"] },
      "mobile": [{ "scheme": ["tydig"], "appLink": false }]
    }
  }
}
